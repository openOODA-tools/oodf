// # oodf Main Entry Point
//
// Logline: Sovereign disk space & mount point storage inspector with dual-surface CLI and MCP stdio interfaces.
//
// Setup: Demands &FsReadCap, &ProcessCap, and &EnvCap tokens for capability-bounded storage inspection.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, --test, or --mcp.
//   2. Load active kernel mount points or synthetic demonstration document.
//   3. Filter mount tables according to filesystem types and target paths.
//   4. Format and output structured tabular reports or JSON telemetry.

import "core/df_types.oo";
import "core/mount_parser.oo";
import "core/df_query.oo";
import "core/df_demo.oo";
import "render/df_view.oo";
import "render/df_json.oo";
import "ipc/df_opts.oo";
import "ipc/mcp_serve.oo";
import "anchor.oo";

fn main(
    fr: &FsReadCap,
    pr: &ProcessCap,
    env: &EnvCap,
    args: List[String]
) -> Int {
    let act: CliAction = parse_cli_args(args);

    if act.show_help {
        print_help();
        return 0;
    }

    if act.show_version {
        print_version();
        return 0;
    }

    if act.is_mcp {
        run_mcp_server(fr);
        return 0;
    }

    if act.run_test {
        if !run_all_tests() {
            println("oodf: internal anchor tests FAILED");
            return 1;
        }
        println("oodf: internal anchor tests PASSED");
        return 0;
    }

    let mounts: List[MountEntry] = if act.config.demo_mode {
        build_demo_mounts()
    } else {
        let loaded: List[MountEntry] = read_mounts_file(fr, "/proc/mounts");
        if list_len(loaded) > 0 {
            loaded
        } else {
            build_demo_mounts()
        }
    };

    let filtered: List[MountEntry] = filter_mounts(mounts, act.config);

    if act.config.json_output {
        print(mounts_to_json(filtered) + "\n");
    } else {
        print(render_table(filtered, act.config));
    }

    return 0;
}

// # oodf ANSI Terminal Theme Palette Engine
//
// Logline: Stylized ANSI color palettes and usage threshold highlighting for disk tables.
//
// Setup: Demands no ambient authority; outputs ANSI escape sequences based on theme names.
//
// Beats:
//   1. Define palette colors for ember, ocean, matrix, cyber, and monochrome themes.
//   2. Provide contextual styling for table headers, device names, and mount points.
//   3. Highlight capacity percentages dynamically based on warning thresholds (80% and 90%).
//   4. Reset styling gracefully for strict terminal etiquette.

pub fn color_reset() -> String {
    return "\x1b[0m";
}

pub fn theme_header(theme: String) -> String {
    if theme == "ocean" {
        return "\x1b[1;36m"; // Bold Cyan
    }
    if theme == "matrix" {
        return "\x1b[1;32m"; // Bold Green
    }
    if theme == "cyber" {
        return "\x1b[1;35m"; // Bold Magenta
    }
    if theme == "monochrome" {
        return "\x1b[1m";    // Bold
    }
    // Default ember: Bold Gold/Yellow
    return "\x1b[1;33m";
}

pub fn theme_dev(theme: String) -> String {
    if theme == "ocean" {
        return "\x1b[34m"; // Blue
    }
    if theme == "matrix" {
        return "\x1b[32m"; // Green
    }
    if theme == "cyber" {
        return "\x1b[36m"; // Cyan
    }
    if theme == "monochrome" {
        return "";
    }
    // Default ember: White / Bright White
    return "\x1b[1;37m";
}

pub fn theme_type(theme: String) -> String {
    if theme == "ocean" {
        return "\x1b[96m"; // Light Cyan
    }
    if theme == "matrix" {
        return "\x1b[92m"; // Light Green
    }
    if theme == "cyber" {
        return "\x1b[95m"; // Light Magenta
    }
    if theme == "monochrome" {
        return "";
    }
    // Default ember: Light Yellow
    return "\x1b[93m";
}

pub fn theme_mount(theme: String) -> String {
    if theme == "ocean" {
        return "\x1b[94m"; // Light Blue
    }
    if theme == "matrix" {
        return "\x1b[32m"; // Green
    }
    if theme == "cyber" {
        return "\x1b[33m"; // Yellow
    }
    if theme == "monochrome" {
        return "";
    }
    // Default ember: Cyan
    return "\x1b[36m";
}

pub fn theme_total(theme: String) -> String {
    if theme == "monochrome" {
        return "\x1b[1m";
    }
    return "\x1b[1;37m"; // Bold White
}

pub fn theme_pct(pct: Int, theme: String) -> String {
    if theme == "monochrome" {
        return "";
    }
    if pct >= 90 {
        return "\x1b[1;31m"; // Bold Red alert
    }
    if pct >= 80 {
        return "\x1b[1;33m"; // Bold Yellow warning
    }
    return "\x1b[32m"; // Green safe
}

pub fn format_bar(pct: Int, width: Int) -> String {
    let mut fill: Int = pct * width / 100;
    if fill > width {
        fill = width;
    }
    if fill < 0 {
        fill = 0;
    }
    let mut s: String = "[";
    let mut i: Int = 0;
    while i < fill {
        s = s + "#";
        i = i + 1;
    }
    while i < width {
        s = s + "-";
        i = i + 1;
    }
    s = s + "]";
    return s;
}
